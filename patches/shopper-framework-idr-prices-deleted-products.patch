+
+    /**
+     * MoneyInput keeps zero-decimal currencies (IDR, JPY, ...) in whole units,
+     * so the 2-decimal rule (999,999.99 major units) would cap them at 999,999.
+     * Allow up to 9 whole-unit digits, which still fits the unsigned integer
+     * price columns.
+     */
+    public static function amountRule(string $currency): string
+    {
+        return is_no_division_currency($currency)
+            ? 'regex:/^\d{1,9}$/'
+            : 'regex:/^\d{1,6}(\.\d{0,2})?$/';
+    }
 }

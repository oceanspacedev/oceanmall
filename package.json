{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "php artisan octane:start --server=frankenphp --host=127.0.0.1 --port=8087",
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "types:check": "vue-tsc --noEmit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:a11y": "playwright test --project=chromium e2e/a11y.spec.ts",
    "test:e2e:all": "playwright test",
    "test:e2e:report": "playwright show-report playwright-report",
    "qa:http": "php scripts/deploy-qa-storefront-e2e.php",
    "qa:full": "npm run test:e2e && DEPLOY_QA_SUITE=regression php scripts/deploy-qa-storefront-e2e.php",
    "qa:clear-throttle": "php artisan cache:clear"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.19.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.23.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.4"
  },
  "dependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "@lucide/vue": "^1.28.0",
    "@shopperlabs/shopper-types": "^2.11.1",
    "@stripe/stripe-js": "^4.10.0",
    "@vueuse/core": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "laravel-vite-plugin": "^3.1",
    "lucide-vue-next": "^0.468.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.1",
    "tw-animate-css": "^1.2.5",
    "vue": "^3.5.13",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@rollup/rollup-win32-x64-msvc": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-win32-x64-msvc": "^1.29.1"
  }
}

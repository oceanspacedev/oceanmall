Treat IDR as a zero-decimal currency and format zero-decimal currencies without fraction digits. Indonesian Rupiah has no circulating sub-unit, so amounts are stored as whole rupiah; without this Shopper divides IDR by 100 on display and multiplies by 100 on save in MoneyInput.

--- a/src/helpers.php	2026-10-12 13:55:06
+++ b/src/helpers.php	2026-10-12 13:55:06
@@ -85,11 +85,13 @@
     function shopper_money_format(int $amount, ?string $currency = null): string
     {
         $currency = $currency ?? shopper_currency();
+        $noDivision = is_no_division_currency($currency);
 
         return (string) Number::currency(
-            number: is_no_division_currency($currency) ? $amount : $amount / 100,
+            number: $noDivision ? $amount : $amount / 100,
             in: $currency,
-            locale: app()->getLocale()
+            locale: app()->getLocale(),
+            precision: $noDivision ? 0 : null,
         );
     }
 }
@@ -122,7 +124,7 @@
     function zero_decimal_currencies(): array
     {
         return [
-            'BIF', 'CLP', 'DJF', 'GNF', 'HTG', 'JPY', 'KMF', 'KRW',
+            'BIF', 'CLP', 'DJF', 'GNF', 'HTG', 'IDR', 'JPY', 'KMF', 'KRW',
             'MGA', 'PYG', 'RWF', 'VND', 'VUV', 'XAF', 'XAG', 'XAU',
             'XDR', 'XOF', 'XPF',
         ];
@@ -132,6 +134,6 @@
 if (! function_exists('is_no_division_currency')) {
     function is_no_division_currency(string $currency): bool
     {
-        return in_array($currency, zero_decimal_currencies());
+        return in_array(strtoupper($currency), zero_decimal_currencies(), true);
     }
 }

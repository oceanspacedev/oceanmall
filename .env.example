APP_NAME=OceanMall
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Proxies allowed to set X-Forwarded-* (comma separated, CIDR ok). Never '*' in production:
# anyone reaching Octane directly could then spoof their IP past rate limits.
# TRUSTED_PROXIES=127.0.0.1,::1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Production seed (`php artisan db:seed --force` with APP_ENV=production) creates only the
# catalog and this ONE administrator (skipped if an administrator already exists).
# Password: at least 12 characters. Remove it from the env after the first deploy.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=OceanMall

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Komerce module (app/Integrations/Komerce). Every key is optional: with all of
# them empty the store runs on Shopper's own manual payment methods, carriers with
# zone shipping options and manual AWB entry (README: "Running without Komerce").
# Api Key List from https://collaborator.komerce.id/settings (click Show / Copy full key)
KOMERCE_SHIPPING_COST_API_KEY=
KOMERCE_SHIPPING_DELIVERY_API_KEY=
KOMERCE_PAYMENT_API_KEY=
# Optional — leave empty to skip QRISLY product and use Payment API QRIS instead
KOMERCE_QRISLY_API_KEY=
# Required only when QRISLY is enabled (from Collaborator upload-qris)
KOMERCE_QRISLY_QRIS_ID=
# KOMERCE_QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
# KOMERCE_QRISLY_UNIQUE_AMOUNT=true
# Master switch for the Komerce collaborator integration (payment + RajaOngkir).
# Leave unset to auto-detect readiness independently from each service's own key.
# Set to false to force the whole integration off even if keys are present.
# KOMERCE_ENABLED=
# Per-driver operator switches (default on): false / 0 / off takes one shipping
# driver out of checkout, fulfilment and tracking even when its key is set.
# SHIPPING_RAJAONGKIR_ENABLED=true
# SHIPPING_KOMERCE_ENABLED=true
# With a shipping provider configured, offer Shopper's zone options (e.g. the
# flat "Reguler" rate) when the provider returns no rate (quota, outage,
# uncovered destination). Default false: checkout shows no courier and why.
# SHIPPING_FALLBACK_TO_ZONE_OPTIONS=false
# Also offer Shopper's zone options of manual carriers (e.g. "Ambil di toko")
# NEXT TO the provider's courier quotes. Default false: provider quotes only.
# SHIPPING_COMBINE_ZONE_OPTIONS=false
# Base URLs: leave these commented. Outside production they default to the
# sandbox hosts; with APP_ENV=production there is no default, so a missing URL
# fails loudly instead of sending live checkouts to the sandbox. Set them only
# in production (or to point at another host):
#   Payment / QRISLY: https://api.collaborator.komerce.id/user   (sandbox: https://api-sandbox.collaborator.komerce.id/user)
#   Shipping Delivery: https://api.collaborator.komerce.id       (sandbox: https://api-sandbox.collaborator.komerce.id)
#   Shipping Cost:     https://rajaongkir.komerce.id             (one host, default)
# KOMERCE_PAYMENT_BASE_URL=
# RAJAONGKIR_DELIVERY_BASE_URL=
# RAJAONGKIR_COST_BASE_URL=
# Kosongkan: daftar kurir diambil dari provider via `php artisan shipping:sync-carriers`
RAJAONGKIR_COURIERS=
# Not from the Api Key List — invent your own secret; sent as callback_API_KEY
# Payment callbacks verify X-Callback-Api-Key as HMAC-SHA256(raw body, this secret)
KOMERCE_WEBHOOK_SECRET=
# VA expiry in seconds (official create example 86400; minimum 3600)
# KOMERCE_PAYMENT_EXPIRY_DURATION=86400
KOMERCE_PICKUP_VEHICLE=Motor
KOMERCE_PICKUP_TIME=10:00:00
KOMERCE_TIMEOUT=30

# --- Other provider modules (plug and play) -----------------------------------
# Each module (app/Integrations/<Name>) is always registered but stays fully
# inert until its API key is set. Fill a key to plug the provider in; set its
# PAYMENT_<X>_ENABLED / SHIPPING_<X>_ENABLED=false to take it out again while
# keeping the key. README: "Ganti-ganti provider (plug and play)".
#
# ONE payment gateway and ONE shipping provider sell at a time, even when
# several hold a key. Name the one to use (payment: komerce, xendit, midtrans;
# shipping: komerce, biteship, kiriminaja; "none" = Shopper manual only).
# Empty = the first keyed one in bootstrap/providers.php order. The others
# take no new orders but still finish the ones they hold.
# Check with: php artisan providers:status
# PAYMENT_PROVIDER=
# SHIPPING_PROVIDER=

# Xendit (Invoice, hosted checkout). xnd_development_* = test, xnd_production_* = live.
XENDIT_SECRET_KEY=
# Dashboard > Settings > Webhooks: verification token; webhook URL {APP_URL}/webhooks/xendit/invoice
XENDIT_CALLBACK_TOKEN=
# XENDIT_INVOICE_DURATION=86400
# XENDIT_SUCCESS_REDIRECT_URL=
# XENDIT_FAILURE_REDIRECT_URL=
# XENDIT_ALLOW_DEVELOPMENT_KEY_IN_PRODUCTION=false
# PAYMENT_XENDIT_ENABLED=true

# Midtrans (Snap, hosted checkout). Notification URL {APP_URL}/webhooks/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Must be set explicitly in production (true); unset outside production = sandbox
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_EXPIRY_MINUTES=1440
# MIDTRANS_FINISH_URL=
# PAYMENT_MIDTRANS_ENABLED=true

# Biteship (rates, area search, orders/pickup, tracking). biteship_test.* / biteship_live.*
BITESHIP_API_KEY=
# Invent a secret; set it as custom header X-Biteship-Secret on the dashboard
# webhook {APP_URL}/webhooks/biteship (events order.status, order.waybill_id, order.price)
BITESHIP_WEBHOOK_SECRET=
# BITESHIP_DELIVERY_TYPE=now
# BITESHIP_PICKUP_TIME=10:00
# BITESHIP_RATE_CACHE_HOURS=12
# BITESHIP_ALLOW_TEST_KEY=false
# BITESHIP_ALLOW_LIVE_KEY=false
# SHIPPING_BITESHIP_ENABLED=true

# KiriminAja (rates, kecamatan search, request pickup, tracking).
KIRIMINAJA_API_KEY=
# Leave commented outside production (defaults to sandbox https://tdev.kiriminaja.com);
# production MUST set https://client.kiriminaja.com
# KIRIMINAJA_BASE_URL=
# Optional ?token= on the callback URL; register it with `php artisan kiriminaja:set-callback`
KIRIMINAJA_WEBHOOK_SECRET=
# KIRIMINAJA_PICKUP_SCHEDULE=auto
# KIRIMINAJA_INSURANCE=false
# KIRIMINAJA_RATE_CACHE_HOURS=12
# SHIPPING_KIRIMINAJA_ENABLED=true

# Only when the selected shipping provider has several destination-based
# drivers: whose area vocabulary address forms use. Normally leave empty.
# SHIPPING_DESTINATION_DRIVER=

# Stripe off by default — leave false unless you intentionally enable it
PAYMENT_STRIPE_ENABLED=false
PAYMENT_SANDBOX=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Deploy HTTP E2E (scripts/deploy-e2e.php) — run from laptop/CI against live URL
# DEPLOY_BASE_URL=https://your-domain.com
# DEPLOY_E2E_EMAIL=customer@oceanmall.test
# DEPLOY_E2E_PASSWORD=password123
# DEPLOY_E2E_MODE=smoke
# # customer|full against non-local hosts requires:
# DEPLOY_E2E_CONFIRM=YES
# # full mode also needs the same secret as the server:
# DEPLOY_E2E_WEBHOOK_SECRET=
# DEPLOY_E2E_PAYMENT=qris
# DEPLOY_E2E_PRODUCT_SLUG=
# DEPLOY_E2E_DESTINATION=Jakarta Selatan
# DEPLOY_E2E_COUPON=OCEAN10
#
# Deep storefront auditor (scripts/deploy-storefront-deep-e2e.php):
# DEPLOY_E2E_MODE=audit
# DEPLOY_E2E_PLACE_ORDER=NO
# # place-order on non-local also needs DEPLOY_E2E_CONFIRM=YES
#
# QA Test Engineer runner (scripts/deploy-qa-storefront-e2e.php) — see docs/qa/storefront-deploy-qa-plan.md
# DEPLOY_QA_SUITE=regression
# DEPLOY_QA_EMAIL=customer@oceanmall.test
# DEPLOY_QA_PASSWORD=password123
# DEPLOY_QA_STRICT=NO
# DEPLOY_QA_PLACE_ORDER=NO
# # place-order on non-local also needs DEPLOY_QA_CONFIRM=YES
# DEPLOY_QA_PRODUCT_SLUG=
# DEPLOY_QA_DESTINATION=Jakarta Selatan
# DEPLOY_QA_COUPON=OCEAN10
# DEPLOY_QA_SLOW_MS=3000

# Customer support contact shown on the public /bantuan, /legal/* and /hapus-akun pages that the
# App Store and Play listings link to. Keep identical to EXPO_PUBLIC_SUPPORT_EMAIL and
# EXPO_PUBLIC_SUPPORT_WHATSAPP in mobile/.env.production. WhatsApp: digits, international, no '+'.
# Outside local development, /legal/* and /bantuan answer 404 until the legal text is approved
# ("draft": false in mobile/lib/legal-content.json) and at least one contact is set; /hapus-akun
# only needs a contact.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Customer mobile API (Bearer token, prefix /api/v1) — Sanctum personal access tokens
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Lifetime of a mobile app login in MINUTES, counted from sign-in (default
# 129600 = 90 days). After it the app asks to sign in again. On the first
# deploy every app login older than this is signed out at once.
# SANCTUM_EXPIRATION=129600
# Demo account(s) shared with Apple App Review / Google Play reviewers, comma separated. These
# keep their sessions on several devices at once; every other account stays one device per account.
# REVIEWER_DEMO_EMAILS=reviewer@oceanmall.test

# Playwright browser QA (npm run test:e2e)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000
# PLAYWRIGHT_EMAIL=customer@oceanmall.test
# PLAYWRIGHT_PASSWORD=password123

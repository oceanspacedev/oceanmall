# Laravel API v1 for local development. Copy to .env (gitignored).
# Simulator/emulator defaults live in lib/config.ts and apply when this is unset:
#   iOS simulator    -> http://127.0.0.1:8000/api/v1
#   Android emulator -> http://10.0.2.2:8000/api/v1
#
# Physical device: use your machine LAN IP and serve Laravel with --host=0.0.0.0
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional in development, all four variables are read by lib/config.ts. Unset values are simply empty.
# Public storefront origin (product share links); defaults to EXPO_PUBLIC_API_URL minus /api/v1.
# EXPO_PUBLIC_WEB_URL=http://127.0.0.1:8000
# Support contact; WhatsApp is digits in international format without '+' (e.g. 62812xxxxxxxx).
# Optional here (the rows that use it simply hide), but REQUIRED in .env.production: a release build
# fails without at least one valid contact.
# EXPO_PUBLIC_SUPPORT_WHATSAPP=
# EXPO_PUBLIC_SUPPORT_EMAIL=

# Release builds do NOT read this file: they read .env.production (committed, https only).
# .env.local or .env.production.local override both, so keep them out of release machines.

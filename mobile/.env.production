# Release configuration. Production builds (eas build --profile production, Xcode Release,
# gradlew assembleRelease/bundleRelease, expo export) read THIS file instead of .env.
# This is the single source of truth for the production host: do not repeat it in eas.json.
#
# Every key below is listed on purpose, even when empty. Expo merges .env.local and .env into a
# release build for any key this file does not define, so a dev value (a local web URL, a personal
# test email) could leak into a store build. An empty value here still counts as defined and
# blocks that. Machine-local .env*.local files are gitignored and must not exist on a release
# machine.
#
# metro.config.js fails the build while EXPO_PUBLIC_API_URL is missing, still CHANGE-ME, or not
# https, while no usable support contact is set (below), and while the legal text is still a draft
# (EAS profile "preview" is exempt), so nothing half-configured can reach TestFlight or Play. All
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone: never put secrets here.
#
# TODO(owner): replace CHANGE-ME.example with the real production host.
EXPO_PUBLIC_API_URL=https://CHANGE-ME.example/api/v1

# Public storefront origin for product share links (<origin>/shop/<slug>). Leave empty to derive it
# by stripping /api/v1 from EXPO_PUBLIC_API_URL (the normal case).
EXPO_PUBLIC_WEB_URL=

# Customer support contact shown in the app. REQUIRED for a release build: set at least one
# (metro.config.js refuses to bundle without a valid one). Use the same contact in the store
# listings (the Laravel backend has no support settings or public support page yet).
# WhatsApp: digits in international format, no '+' (e.g. 62812xxxxxxxx).
# TODO(owner): fill EXPO_PUBLIC_SUPPORT_EMAIL and/or EXPO_PUBLIC_SUPPORT_WHATSAPP.
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_EMAIL=

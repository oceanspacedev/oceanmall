APP_NAME=OceanMall
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Api Key List from https://collaborator.komerce.id/settings (click Show / Copy full key)
KOMERCE_SHIPPING_COST_API_KEY=
KOMERCE_SHIPPING_DELIVERY_API_KEY=
KOMERCE_PAYMENT_API_KEY=
# Optional — leave empty to skip QRISLY product and use Payment API QRIS instead
KOMERCE_QRISLY_API_KEY=
# Required only when QRISLY is enabled (from Collaborator upload-qris)
KOMERCE_QRISLY_QRIS_ID=
# KOMERCE_QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
# KOMERCE_QRISLY_UNIQUE_AMOUNT=true
# Master switch for the Komerce collaborator integration (payment + RajaOngkir).
# Leave unset to auto-detect readiness independently from each service's own key.
# Set to false to force the whole integration off even if keys are present.
# KOMERCE_ENABLED=
KOMERCE_PAYMENT_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
RAJAONGKIR_COST_BASE_URL=https://rajaongkir.komerce.id
RAJAONGKIR_DELIVERY_BASE_URL=https://api-sandbox.collaborator.komerce.id
# Kosongkan: daftar kurir diambil dari provider via `php artisan komerce:sync-carriers`
RAJAONGKIR_COURIERS=
# Not from the Api Key List — invent your own secret; sent as callback_API_KEY
# Payment callbacks verify X-Callback-Api-Key as HMAC-SHA256(raw body, this secret)
KOMERCE_WEBHOOK_SECRET=
# VA expiry in seconds (official create example 86400; minimum 3600)
# KOMERCE_PAYMENT_EXPIRY_DURATION=86400
KOMERCE_PICKUP_VEHICLE=Motor
KOMERCE_PICKUP_TIME=10:00:00
KOMERCE_TIMEOUT=30

# Stripe off by default — leave false unless you intentionally enable it
PAYMENT_STRIPE_ENABLED=false
PAYMENT_SANDBOX=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Deploy HTTP E2E (scripts/deploy-e2e.php) — run from laptop/CI against live URL
# DEPLOY_BASE_URL=https://your-domain.com
# DEPLOY_E2E_EMAIL=customer@oceanmall.test
# DEPLOY_E2E_PASSWORD=password123
# DEPLOY_E2E_MODE=smoke
# # customer|full against non-local hosts requires:
# DEPLOY_E2E_CONFIRM=YES
# # full mode also needs the same secret as the server:
# DEPLOY_E2E_WEBHOOK_SECRET=
# DEPLOY_E2E_PAYMENT=qris
# DEPLOY_E2E_PRODUCT_SLUG=
# DEPLOY_E2E_DESTINATION=Jakarta Selatan
# DEPLOY_E2E_COUPON=OCEAN10
#
# Deep storefront auditor (scripts/deploy-storefront-deep-e2e.php):
# DEPLOY_E2E_MODE=audit
# DEPLOY_E2E_PLACE_ORDER=NO
# # place-order on non-local also needs DEPLOY_E2E_CONFIRM=YES
#
# QA Test Engineer runner (scripts/deploy-qa-storefront-e2e.php) — see docs/qa/storefront-deploy-qa-plan.md
# DEPLOY_QA_SUITE=regression
# DEPLOY_QA_EMAIL=customer@oceanmall.test
# DEPLOY_QA_PASSWORD=password123
# DEPLOY_QA_STRICT=NO
# DEPLOY_QA_PLACE_ORDER=NO
# # place-order on non-local also needs DEPLOY_QA_CONFIRM=YES
# DEPLOY_QA_PRODUCT_SLUG=
# DEPLOY_QA_DESTINATION=Jakarta Selatan
# DEPLOY_QA_COUPON=OCEAN10
# DEPLOY_QA_SLOW_MS=3000

# Customer mobile API (Bearer token, prefix /api/v1) — Sanctum personal access tokens
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Playwright browser QA (npm run test:e2e)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000
# PLAYWRIGHT_EMAIL=customer@oceanmall.test
# PLAYWRIGHT_PASSWORD=password123
